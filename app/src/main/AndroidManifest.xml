<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AddEditDeviceActivity" android:exported="false" />
        <activity android:name=".AddEditAodActivity" android:exported="false" />
        <activity android:name=".ScreenActivity" android:exported="false" />
        <activity android:name=".LogActivity" android:exported="false" />
        <activity android:name=".RunScriptActivity" android:exported="false" />

    </application>
</manifest>